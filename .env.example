# HexLegIA - Configuration d'Environnement
# ========================================
# Copier ce fichier en .env et adapter les valeurs
# NE JAMAIS COMMITER DE VRAIS SECRETS DANS LE DÉPÔT

# ========================================
# PostgreSQL Configuration
# ========================================
POSTGRES_USER=hexlegia
POSTGRES_PASSWORD=hexlegia_password
POSTGRES_DB=hexlegia_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ========================================
# Qdrant Configuration (Recherche Vectorielle)
# ========================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=test-qdrant-key

# ========================================
# Backend Configuration
# ========================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=true
SECRET_KEY=change-me-in-production-for-jwt-signing
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ========================================
# Frontend Configuration
# ========================================
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
REACT_APP_API_URL=http://localhost:8000

# ========================================
# AI Providers Configuration
# ========================================
# Mistral AI
MISTRAL_API_KEY=test-mistral-api-key
MISTRAL_API_URL=https://api.mistral.ai/v1

# OpenAI
OPENAI_API_KEY=test-openai-api-key
OPENAI_API_URL=https://api.openai.com/v1

# ========================================
# Logging Configuration
# ========================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ========================================
# Audit Configuration
# ========================================
AUDIT_ENABLED=true
AUDIT_LOG_FILE=/var/log/hexlegia/audit.log

# ========================================
# Security Configuration
# ========================================
# CORS Origins (séparés par des virgules)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ========================================
# Docker Network Configuration
# ========================================
DOCKER_NETWORK=hexlegia-network
